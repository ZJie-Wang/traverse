{
	"compilerOptions": {
		"allowJs": false,
		"baseUrl": ".",
		"esModuleInterop": true,
		"importHelpers": true,
		"inlineSources": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"lib": ["DOM", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noImplicitAny": true,
		"strict": true,
		"target": "ES2018",
		"useUnknownInCatchVariables": true
	},
	"include": ["src/**/*.ts"]
}
