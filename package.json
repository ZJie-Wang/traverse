{
	"name": "traverse",
	"version": "0.1.0",
	"description": "Browse, preview, and manage vault files from a fast, keyboard-driven view.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"lint": "eslint src/",
		"test": "tsx --test tests/*.test.ts",
		"check:release": "node scripts/check-release.mjs",
		"check": "npm test && npm run lint && npm run build && npm run check:release"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"file-explorer",
		"preview"
	],
	"author": "ZJie-Wang",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZJie-Wang/traverse.git"
	},
	"bugs": "https://github.com/ZJie-Wang/traverse/issues",
	"homepage": "https://github.com/ZJie-Wang/traverse#readme",
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@typescript-eslint/parser": "^8.35.1",
		"esbuild": "^0.28.1",
		"eslint": "^9.30.1",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^14.0.0",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"tsx": "^4.23.1",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.35.1"
	},
	"dependencies": {
		"pinyin-match": "^1.2.10"
	}
}
